# VPS Backend Configuration
BOT_TOKEN=your_telegram_bot_token
CHAT_ID=your_telegram_chat_id
APP_URL=https://your-cloudflare-tunnel-url/app
QBIT_USER=admin
QBIT_PASS=your_qbit_password
DAEMON_API_KEY=your_secure_api_key

# Local Daemon Configuration
VPS_API_URL=https://your-cloudflare-tunnel-url
VPS_USER=vps_username
VPS_HOST=vps_public_ip
VPS_READY_PATH=/mnt/torrents/ready
SSH_KEY_PATH=/path/to/your/ssh/private/key
LOCAL_DEST=/path/to/local/downloads
POLL_INTERVAL=30
MAX_CONCURRENT=1
